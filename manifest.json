{
  "manifest_version": 3,
  "name": "RI Opac chapter To Zotero",
  "version": "1.0",
  "permissions": ["activeTab", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:23124/*", "http://127.0.0.1:23119/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
   "icons": {
    "96": "icon/favicon.png"
  },
 "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://opac.regesta-imperii.de/*"
      ]
    }
  ]
}